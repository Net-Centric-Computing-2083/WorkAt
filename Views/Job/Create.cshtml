@model WorkAt.Models.Job

@{
    ViewData["Title"] = "Post a New Job";
}

<div class="py-2" style="max-width: 720px; margin: 0 auto;">
    <div class="mb-4">
        <h1 class="h2 mb-1">Post a New Job</h1>
        <p class="text-muted">Describe the position and requirements to attract qualified applicants.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

                <!-- Position Basics -->
                <div class="mb-4">
                    <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">1. Role Information</h2>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">
                            Job Title <span class="input-required">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Senior Backend Engineer" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="EmploymentType" class="form-label">Employment Type</label>
                            <select asp-for="EmploymentType" class="form-select">
                                <option value="">Select Employment Type</option>
                                <option value="Full Time">Full Time</option>
                                <option value="Part Time">Part Time</option>
                                <option value="Contract">Contract</option>
                                <option value="Internship">Internship</option>
                            </select>
                            <span asp-validation-for="EmploymentType" class="text-danger"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Kathmandu, Nepal" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Compensation & Timing -->
                <div class="mb-4">
                    <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">2. Compensation &amp; Deadline</h2>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Salary" class="form-label">Salary / Compensation</label>
                            <input asp-for="Salary" class="form-control" placeholder="e.g. NPR 30,000 - 50,000 / month" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="Deadline" class="form-label">Application Deadline</label>
                            <input asp-for="Deadline" type="date" class="form-control" />
                            <span asp-validation-for="Deadline" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Detailed Content -->
                <div class="mb-4">
                    <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">3. Job Description &amp; Requirements</h2>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            Job Description <span class="input-required">*</span>
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Detail the core duties, day-to-day work, and impact of the role..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Requirements" class="form-label">Requirements &amp; Qualifications</label>
                        <textarea asp-for="Requirements" class="form-control" rows="4" placeholder="Skills, qualifications, years of experience, or preferred background..."></textarea>
                        <span asp-validation-for="Requirements" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Publish Job
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}