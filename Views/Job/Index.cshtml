@model IEnumerable<WorkAt.Models.Job>

@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="py-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">Manage Jobs</h1>
            <p class="text-muted mb-0">Review, update, or remove your company job postings.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                Post New Job
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center">
            <h3 class="h5 text-dark mb-2">No jobs posted yet</h3>
            <p class="text-muted small mb-3">Create your first job listing to start receiving candidate applications.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary">Post a Job</a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Salary</th>
                            <th>Posted Date</th>
                            <th>Deadline</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">
                                    @job.Title
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrWhiteSpace(job.Location) ? "—" : job.Location)
                                </td>
                                <td>
                                    <span class="job-meta-tag">@(job.EmploymentType ?? "Full Time")</span>
                                </td>
                                <td class="text-secondary small">
                                    @(string.IsNullOrWhiteSpace(job.Salary) ? "—" : job.Salary)
                                </td>
                                <td class="text-muted small">
                                    @job.PostedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-muted small">
                                    @(job.Deadline?.ToLocalTime().ToString("MMM dd, yyyy") ?? "Open")
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-secondary">
                                            View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>