@model WorkAt.Models.Job

@{
    ViewData["Title"] = "Delete Job Listing";
}

<div class="py-2" style="max-width: 600px; margin: 0 auto;">
    <div class="mb-4">
        <h1 class="h2 mb-1 text-danger">Delete Job Listing</h1>
        <p class="text-muted">Are you sure you want to delete this job posting? This action cannot be undone.</p>
    </div>

    <div class="card p-4 mb-4">
        <h2 class="h5 mb-2">@Model.Title</h2>
        <div class="text-secondary small mb-3">
            @(string.IsNullOrWhiteSpace(Model.Location) ? "No location specified" : Model.Location) &bull;
            @(string.IsNullOrWhiteSpace(Model.EmploymentType) ? "Full Time" : Model.EmploymentType)
        </div>

        <p class="text-muted small mb-4">
            Posted on @Model.PostedDate.ToLocalTime().ToString("MMM dd, yyyy"). Any pending applications associated with this job may be impacted.
        </p>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="JobId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>