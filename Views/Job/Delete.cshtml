@model WorkAt.Models.Job

@{
    ViewData["Title"] = "Delete Job";
}

<h1>Delete Job</h1>

<h3>Are you sure you want to delete this job?</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Title
        </dt>
        <dd class="col-sm-9">
            @Model.Title
        </dd>

        <dt class="col-sm-3">
            Location
        </dt>
        <dd class="col-sm-9">
            @Model.Location
        </dd>

        <dt class="col-sm-3">
            Salary
        </dt>
        <dd class="col-sm-9">
            @Model.Salary
        </dd>

        <dt class="col-sm-3">
            Employment Type
        </dt>
        <dd class="col-sm-9">
            @Model.EmploymentType
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="JobId" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>