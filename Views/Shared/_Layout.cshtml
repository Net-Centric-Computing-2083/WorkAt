@using Microsoft.AspNetCore.Identity
@using WorkAt.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkAt</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkAt.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-md workat-navbar">
            <div class="container">
                <!-- Brand -->
                <a class="workat-brand" asp-controller="Home" asp-action="Index">
                    <span class="workat-brand-name">WorkAt</span>
                    <span class="workat-brand-subtitle">A Job Portal System</span>
                </a>
                <!-- Mobile menu toggle -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-md-0 gap-1">

                        <!-- Public / Guest Navigation -->
                        <!-- Job Seeker Navigation -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("JobSeeker"))
                        {
                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="JobSeeker" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Jobs" asp-action="Index">
                                    Find Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Application" asp-action="MyApplications">
                                    My Applications
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Resume" asp-action="Index">
                                    Resume
                                </a>
                            </li>


                        }

                        <!-- Company Navigation -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Company"))
                        {
                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Company" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Job" asp-action="Index">
                                    Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Application" asp-action="CompanyApplications">
                                    Applications
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Authentication Navigation -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="workat-footer">
        <div class="container">
            <div class="workat-footer-inner">
                <div>
                    &copy; 2026 WorkAt. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>