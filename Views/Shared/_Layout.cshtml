@using Microsoft.AspNetCore.Identity
@using WorkAt.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkAt</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkAt.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-md workat-navbar">
            <div class="container">
                <!-- Brand -->
                <a class="workat-brand" asp-controller="Home" asp-action="Index">
                    <span class="workat-brand-name">WorkAt</span>
                    <span class="workat-brand-subtitle">A Job Portal System</span>
                </a>
                <!-- Mobile menu toggle -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-md-0 gap-1">

                        <!-- Admin Navigation -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Admin" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Admin" asp-action="Companies">
                                    Companies
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Admin" asp-action="JobSeekers">
                                    Job Seekers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Admin" asp-action="Applications">
                                    Applications
                                </a>
                            </li>
                        }

                        <!-- Job Seeker Navigation -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("JobSeeker"))
                        {
                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="JobSeeker" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Jobs" asp-action="Index">
                                    Find Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Application" asp-action="MyApplications">
                                    My Applications
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Resume" asp-action="Index">
                                    Resume
                                </a>
                            </li>
                        }

                        <!-- Company Navigation -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Company"))
                        {
                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Company" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Job" asp-action="Index">
                                    Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="workat-nav-link" asp-controller="Application" asp-action="CompanyApplications">
                                    Applications
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Authentication Navigation -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="workat-footer">
        <div class="container">
            <div class="workat-footer-inner d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    &copy; 2026 WorkAt. All rights reserved.
                </div>
                <div>
                    <a class="text-muted text-decoration-none small" asp-controller="Admin" asp-action="Login">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="bi bi-shield-lock me-1" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                            <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 1 1 9.5 6.5z"/>
                        </svg>
                        Admin Portal
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>