@model WorkAt.Models.JobSeeker

@{
    ViewData["Title"] = "Job Seeker Dashboard";
}

<div class="py-2">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Verification Status Banner -->
    @if (Model.Status == "Pending")
    {
        <div class="alert alert-info d-flex align-items-center gap-3 mb-4" role="alert">
            <div>
                <span class="badge badge-pending me-2">Pending Verification</span>
                <strong>Account Awaiting Admin Approval:</strong> Your job seeker profile is currently being reviewed by an administrator. You will be able to apply for jobs once your account is verified.
            </div>
        </div>
    }
    else if (Model.Status == "Rejected")
    {
        <div class="alert alert-danger d-flex align-items-center gap-3 mb-4" role="alert">
            <div>
                <span class="badge badge-rejected me-2">Verification Rejected</span>
                <strong>Account Verification Suspended:</strong> Your job seeker account has been rejected or unverified by an administrator. Job application privileges are currently disabled.
            </div>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h2 mb-0">@Model.FirstName @Model.LastName</h1>
                @if (Model.Status == "Verified")
                {
                    <span class="badge badge-accepted">Verified</span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge badge-rejected">Rejected</span>
                }
                else
                {
                    <span class="badge badge-pending">Pending</span>
                }
            </div>
            <p class="text-muted mb-0">Candidate Profile &amp; Application Status</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EditProfile" class="btn btn-secondary">
                Edit Profile
            </a>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary">
                Find Jobs
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Personal Info -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Personal Information</span>
                    <a asp-action="EditProfile" class="btn btn-sm btn-outline-secondary">Edit</a>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Full Name</div>
                            <div class="fw-semibold text-dark">@Model.FirstName @Model.LastName</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Email Address</div>
                            <div class="fw-semibold text-dark">@(Model.User?.Email ?? "N/A")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Phone Number</div>
                            <div class="text-dark">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Address</div>
                            <div class="text-dark">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resume Status -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Resume Status</span>
                    @if (Model.Resume != null)
                    {
                        <a asp-controller="Resume" asp-action="Edit" class="btn btn-sm btn-outline-secondary">Edit Resume</a>
                    }
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    @if (Model.Resume == null)
                    {
                        <div>
                            <h3 class="h6 text-muted mb-2">No Resume Created</h3>
                            <p class="text-secondary small mb-3">
                                Creating a resume allows employers to view your background, education, and technical skills when reviewing your applications.
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Resume" asp-action="Create" class="btn btn-sm btn-primary">
                                Create Resume Now
                            </a>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge badge-accepted">Resume Active</span>
                                <span class="text-muted small">@Model.Resume.ResumeSkills.Count skills listed</span>
                            </div>
                            <p class="text-secondary small mb-3 text-truncate-2">
                                @(string.IsNullOrWhiteSpace(Model.Resume.Summary) ? "No summary added yet." : Model.Resume.Summary)
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Resume" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                View Full Resume &rarr;
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Applications -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>My Applications</span>
            <a asp-controller="Application" asp-action="MyApplications" class="btn btn-sm btn-outline-secondary">
                View All
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.Applications != null && Model.Applications.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Role</th>
                                <th>Company</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications.OrderByDescending(a => a.AppliedDate).Take(5))
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @(app.Job?.Title ?? "Unknown Position")
                                    </td>
                                    <td class="text-secondary">
                                        @(app.Job?.Company?.CompanyName ?? "Unknown Company")
                                    </td>
                                    <td class="text-muted small">
                                        @app.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (app.Status == "Accepted")
                                        {
                                            <span class="badge badge-accepted">Accepted</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge badge-rejected">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Application" asp-action="Details" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-3">You haven't submitted any job applications yet.</p>
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-sm btn-primary">
                        Browse Open Jobs
                    </a>
                </div>
            }
        </div>
    </div>
</div>