@model WorkAt.Models.JobSeeker

@{
    ViewData["Title"] = "JobSeeker Dashboard";
}

<div class="container mt-4">

    @* Success message after updating profile *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="mb-4">
        <h2>JobSeeker Dashboard</h2>
        <p class="text-muted">
            Welcome, @Model.FirstName @Model.LastName!
        </p>
    </div>

    <!-- Profile -->
    <div class="card mb-4">

        <div class="card-header">
            <h4 class="mb-0">My Profile</h4>
        </div>

        <div class="card-body">

            <p>
                <strong>Name:</strong>
                @Model.FirstName @Model.LastName
            </p>

            <p>
                <strong>Phone:</strong>
                @(string.IsNullOrWhiteSpace(Model.Phone)
                    ? "Not provided"
                    : Model.Phone)
            </p>

            <p class="mb-3">
                <strong>Address:</strong>
                @(string.IsNullOrWhiteSpace(Model.Address)
                    ? "Not provided"
                    : Model.Address)
            </p>

            <a asp-controller="JobSeeker"
               asp-action="EditProfile"
               class="btn btn-primary">
                Edit Profile
            </a>

        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">

        <!-- Resume -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5>My Resume</h5>

                    @if (Model.Resume == null)
                    {
                        <p class="text-muted">
                            You have not created your resume yet.
                        </p>

                        <a asp-controller="Resume"
                           asp-action="Create"
                           class="btn btn-primary">
                            Create Resume
                        </a>
                    }
                    else
                    {
                        <p>
                            Your resume is available.
                        </p>

                        <a asp-controller="Resume"
                           asp-action="Index"
                           class="btn btn-primary">
                            View My Resume
                        </a>
                    }

                </div>
            </div>
        </div>

        <!-- Find Jobs -->
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5>Find Jobs</h5>

                    <p class="text-muted">
                        Search for available job opportunities.
                    </p>

                    <a asp-controller="Jobs"
                       asp-action="Index"
                       class="btn btn-success">
                        Browse Jobs
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- Applications -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">My Applications</h4>
            <a asp-controller="Application" asp-action="MyApplications" class="btn btn-sm btn-outline-primary">
                View All Applications
            </a>
        </div>

        <div class="card-body">

            @if (Model.Applications != null &&
                 Model.Applications.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped align-middle">

                        <thead>
                            <tr>
                                <th>Job</th>
                                <th>Company</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <td>
                                        <strong>@(application.Job?.Title ?? "Unknown")</strong>
                                    </td>

                                    <td>
                                        @(application.Job?.Company?.CompanyName ?? "Unknown")
                                    </td>

                                    <td>
                                        @application.AppliedDate
                                        .ToLocalTime()
                                        .ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @if (application.Status == "Accepted")
                                        {
                                            <span class="badge bg-success">Accepted</span>
                                        }
                                        else if (application.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Application"
                                           asp-action="Details"
                                           asp-route-id="@application.ApplicationId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    You have not applied for any jobs yet.
                </p>
            }

        </div>

    </div>

</div>