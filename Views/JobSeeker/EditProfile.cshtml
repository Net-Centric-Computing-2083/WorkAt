@model WorkAt.Models.JobSeeker

@{
    ViewData["Title"] = "Edit Candidate Profile";
}

<div class="py-2" style="max-width: 640px; margin: 0 auto;">
    <div class="mb-4">
        <h1 class="h2 mb-1">Edit Candidate Profile</h1>
        <p class="text-muted">Update your contact information and details.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="EditProfile" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="JobSeekerId" />
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label">
                            First Name <span class="input-required">*</span>
                        </label>
                        <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label">
                            Last Name <span class="input-required">*</span>
                        </label>
                        <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">
                        Phone Number <span class="input-required">*</span>
                    </label>
                    <input asp-for="Phone" type="tel" class="form-control" placeholder="+1 (555) 000-0000" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label">
                        Address <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="City, State, Country"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}