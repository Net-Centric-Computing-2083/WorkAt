@model WorkAt.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Welcome back</h2>
            <p>Sign in to continue to WorkAt</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email address
                </label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autofocus autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label mb-0">
                        Password
                    </label>
                </div>
                <div class="position-relative">
                    <input asp-for="Password" type="password" id="passwordInput" class="form-control pe-5" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" 
                            id="togglePasswordBtn" 
                            class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-1 text-decoration-none"
                            onclick="togglePasswordVisibility()"
                            tabindex="-1"
                            style="font-size: 0.75rem;">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                <label asp-for="RememberMe" class="form-check-label small text-secondary" for="rememberMeCheck">
                    Remember me on this device
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                Sign In
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="text-muted small">Don't have an account?</span>
            <a asp-action="Register" class="small fw-semibold ms-1 text-dark">Create an account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById("passwordInput");
            const toggleBtn = document.getElementById("togglePasswordBtn");
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleBtn.textContent = "Hide";
            } else {
                passwordInput.type = "password";
                toggleBtn.textContent = "Show";
            }
        }
    </script>
}
