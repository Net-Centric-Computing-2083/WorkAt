@model WorkAt.Models.Company

@{
    ViewData["Title"] = "Edit Company Profile";
}

<div class="py-2" style="max-width: 640px; margin: 0 auto;">
    <div class="mb-4">
        <h1 class="h2 mb-1">Edit Company Profile</h1>
        <p class="text-muted">Keep your business details updated for applicants.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="CompanyId" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label">
                        Company Name <span class="input-required">*</span>
                    </label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Company Name" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">
                        Phone Number
                    </label>
                    <input asp-for="Phone" type="tel" class="form-control" placeholder="+1 (555) 000-0000" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Website" class="form-label">
                        Website
                    </label>
                    <input asp-for="Website" type="url" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="Website" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label">
                        Address
                    </label>
                    <input asp-for="Address" class="form-control" placeholder="City, State, Country" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">
                        About Company
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Share your mission, culture, and what makes your company unique..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}