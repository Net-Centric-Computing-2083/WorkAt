@model WorkAt.Models.Company

@{
    ViewData["Title"] = "Company Dashboard";
    var totalJobs = Model.Jobs?.Count ?? 0;
    var totalApplications = Model.Jobs?.SelectMany(j => j.Applications)?.Count() ?? 0;
}

<div class="py-2">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Verification Status Banner -->
    @if (Model.Status == "Pending")
    {
        <div class="alert alert-info d-flex align-items-center gap-3 mb-4" role="alert">
            <div>
                <span class="badge badge-pending me-2">Pending Verification</span>
                <strong>Account Awaiting Admin Approval:</strong> Your company profile is currently being reviewed by an administrator. You will be able to post jobs once your account is verified.
            </div>
        </div>
    }
    else if (Model.Status == "Rejected")
    {
        <div class="alert alert-danger d-flex align-items-center gap-3 mb-4" role="alert">
            <div>
                <span class="badge badge-rejected me-2">Verification Rejected</span>
                <strong>Account Verification Suspended:</strong> Your company account has been rejected or unverified by an administrator. Job posting privileges are currently disabled.
            </div>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h2 mb-0">@Model.CompanyName</h1>
                @if (Model.Status == "Verified")
                {
                    <span class="badge badge-accepted">Verified</span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge badge-rejected">Rejected</span>
                }
                else
                {
                    <span class="badge badge-pending">Pending</span>
                }
            </div>
            <p class="text-muted mb-0">Company Profile &amp; Recruitment Overview</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" class="btn btn-secondary">
                Edit Profile
            </a>
            @if (Model.Status == "Verified")
            {
                <a asp-controller="Job" asp-action="Create" class="btn btn-primary">
                    Post a Job
                </a>
            }
            else
            {
                <button type="button" class="btn btn-primary opacity-50" disabled title="Requires Admin verification to post jobs">
                    Post a Job (Awaiting Verification)
                </button>
            }
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3">
                <span class="text-muted small fw-semibold text-uppercase">Active Listings</span>
                <div class="h3 fw-bold my-1 text-dark">@totalJobs</div>
                <a asp-controller="Job" asp-action="Index" class="small text-secondary">Manage jobs &rarr;</a>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card p-3">
                <span class="text-muted small fw-semibold text-uppercase">Total Applications</span>
                <div class="h3 fw-bold my-1 text-dark">@totalApplications</div>
                <a asp-controller="Application" asp-action="CompanyApplications" class="small text-secondary">Review applicants &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Profile Details Card -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Company Information</span>
            <a asp-action="Edit" class="btn btn-sm btn-outline-secondary">Edit</a>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Company Name</div>
                    <div class="fw-semibold text-dark">@Model.CompanyName</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Account Email</div>
                    <div class="fw-semibold text-dark">@(Model.User?.Email ?? "N/A")</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Phone Number</div>
                    <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-1">Website</div>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.Website))
                        {
                            <a href="@Model.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-underline text-dark">
                                @Model.Website
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Not provided</span>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="text-muted small mb-1">Office Address</div>
                    <div class="text-dark">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</div>
                </div>

                <div class="col-12">
                    <div class="text-muted small mb-1">About Company</div>
                    <div class="text-secondary" style="white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided yet." : Model.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>