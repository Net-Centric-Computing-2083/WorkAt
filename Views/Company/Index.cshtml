@model WorkAt.Models.Company

@{
    ViewData["Title"] = "Company Dashboard";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Company Dashboard</h2>
            <p class="text-muted mb-0">Manage your company profile</p>
        </div>
        <a asp-action="Edit" class="btn btn-primary px-4">
            <i class="bi bi-pencil-square me-1"></i> Edit Profile
        </a>
    </div>

    <div class="row g-4">

        <!-- Profile Card -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3"
                             style="width:64px; height:64px; font-size:1.5rem; font-weight:600;">
                            @(Model.CompanyName?.Length > 0 ? Model.CompanyName.Substring(0, 1).ToUpper() : "C")
                        </div>
                        <div>
                            <h4 class="mb-0 fw-semibold">@Model.CompanyName</h4>
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 mt-1">Active</span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-4">
                        <div class="col-12">
                            <small class="text-uppercase text-muted fw-semibold" style="font-size:0.75rem;">About</small>
                            <p class="mb-0 mt-1">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description added yet." : Model.Description)</p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-uppercase text-muted fw-semibold" style="font-size:0.75rem;">Address</small>
                            <p class="mb-0 mt-1">
                                <i class="bi bi-geo-alt me-1"></i>
                                @(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)
                            </p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-uppercase text-muted fw-semibold" style="font-size:0.75rem;">Phone</small>
                            <p class="mb-0 mt-1">
                                <i class="bi bi-telephone me-1"></i>
                                @(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)
                            </p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-uppercase text-muted fw-semibold" style="font-size:0.75rem;">Website</small>
                            <p class="mb-0 mt-1">
                                <i class="bi bi-globe me-1"></i>
                                @if (!string.IsNullOrWhiteSpace(Model.Website))
                                {
                                    <a href="@Model.Website" target="_blank" rel="noopener">@Model.Website</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">Quick Actions</h6>
                    <a asp-action="Edit" class="btn btn-outline-primary w-100 mb-2">
                        <i class="bi bi-pencil me-1"></i> Edit Profile
                    </a>
                    <a asp-controller="Job" asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-briefcase me-1"></i> View My Jobs
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 bg-primary bg-opacity-10">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-1 text-primary">Profile Tip</h6>
                    <p class="mb-0 small text-muted">
                        A complete profile with a clear description and website helps job seekers trust your listings.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>