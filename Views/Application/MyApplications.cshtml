@model IEnumerable<WorkAt.Models.Application>

@{
    ViewData["Title"] = "My Applications";
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">My Applications</h1>
            <p class="text-muted mb-0">Track all job applications you have submitted on WorkAt.</p>
        </div>
        <div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary">
                Browse More Jobs
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card p-5 text-center">
            <h3 class="h5 text-dark mb-2">No applications yet</h3>
            <p class="text-muted small mb-3">You have not submitted any applications. Search available positions to get started.</p>
            <div>
                <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary">
                    Find Opportunities
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Position</th>
                            <th>Company</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold text-dark">@(app.Job?.Title ?? "Unknown Position")</span>
                                </td>
                                <td class="text-secondary">
                                    @(app.Job?.Company?.CompanyName ?? "Unknown Company")
                                </td>
                                <td class="text-muted small">
                                    @app.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    @if (app.Status == "Accepted")
                                    {
                                        <span class="badge badge-accepted">Accepted</span>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span class="badge badge-rejected">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>