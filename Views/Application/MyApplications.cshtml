@model WorkAt.Models.MyApplicationsViewModel

@{
    ViewData["Title"] = "My Applications";
    var startItem = Model.TotalItems == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var endItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems);
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">My Applications</h1>
            <p class="text-muted mb-0">Track all job applications you have submitted on WorkAt.</p>
        </div>
        <div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary">
                Browse More Jobs
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Controls -->
    <div class="card p-3 mb-4">
        <form asp-action="MyApplications" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label for="search" class="form-label">Search</label>
                    <input type="text"
                           id="search"
                           name="search"
                           class="form-control"
                           placeholder="Search by job title or company..."
                           value="@Model.Search" />
                </div>

                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                        <option value="Accepted" selected="@(Model.Status == "Accepted")">Accepted</option>
                        <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="sortOrder" class="form-label">Sort By Date</label>
                    <select id="sortOrder" name="sortOrder" class="form-select">
                        <option value="desc" selected="@(Model.SortOrder == "desc")">Newest First (Descending)</option>
                        <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest First (Ascending)</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Apply
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status) || Model.SortOrder == "asc")
                    {
                        <a asp-action="MyApplications" class="btn btn-secondary" title="Clear Filters">
                            Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Applications.Any())
    {
        <div class="card p-5 text-center">
            <h3 class="h5 text-dark mb-2">No applications found</h3>
            <p class="text-muted small mb-3">No submitted applications match your search or filter criteria.</p>
            <div>
                <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary">
                    Find Opportunities
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">No.</th>
                            <th>Position</th>
                            <th>Company</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var appList = Model.Applications.ToList();
                            for (int i = 0; i < appList.Count; i++)
                            {
                                var app = appList[i];
                                int displayNo = (Model.PageIndex - 1) * Model.PageSize + i + 1;
                                <tr>
                                    <td class="text-center text-muted small fw-medium">@displayNo</td>
                                    <td>
                                        <span class="fw-semibold text-dark">@(app.Job?.Title ?? "Unknown Position")</span>
                                    </td>
                                    <td class="text-secondary">
                                        @(app.Job?.Company?.CompanyName ?? "Unknown Company")
                                    </td>
                                    <td class="text-muted small">
                                        @app.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (app.Status == "Accepted")
                                        {
                                            <span class="badge badge-accepted">Accepted</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge badge-rejected">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="card-footer d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    Showing @startItem to @endItem of @Model.TotalItems application@(Model.TotalItems == 1 ? "" : "s")
                </span>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Application List Pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="MyApplications"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@(Model.PageIndex - 1)">&laquo; Prev</a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="MyApplications"
                                       asp-route-search="@Model.Search"
                                       asp-route-status="@Model.Status"
                                       asp-route-sortOrder="@Model.SortOrder"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="MyApplications"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-page="@(Model.PageIndex + 1)">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>