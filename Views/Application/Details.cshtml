@model WorkAt.Models.Application

@{
    ViewData["Title"] = "Application Details";
    var isCompany = User.IsInRole("Company");
    var isJobSeeker = User.IsInRole("JobSeeker");
}

<div class="py-2">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">Application Details</h1>
            <p class="text-muted mb-0">Application ID #@Model.ApplicationId &bull; Submitted @Model.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</p>
        </div>
        <div>
            @if (isCompany)
            {
                <a asp-action="CompanyApplications" class="btn btn-outline-secondary">
                    &larr; Back to Candidate Applications
                </a>
            }
            else
            {
                <a asp-action="MyApplications" class="btn btn-outline-secondary">
                    &larr; Back to My Applications
                </a>
            }
        </div>
    </div>

    <!-- Status Banner -->
    <div class="card mb-4">
        <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center p-3 gap-2">
            <div>
                <span class="text-muted small">Application Status:</span>
                <span class="ms-2">
                    @if (Model.Status == "Accepted")
                    {
                        <span class="badge badge-accepted">Accepted</span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge badge-rejected">Rejected</span>
                    }
                    else
                    {
                        <span class="badge badge-pending">Pending Review</span>
                    }
                </span>
            </div>
            <div class="text-muted small">
                Last Updated: @Model.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy")
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- Job Details Card -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold">Position Details</h5>
                </div>
                <div class="card-body">
                    <h3 class="h4 text-dark mb-1">@Model.Job?.Title</h3>
                    <p class="text-secondary fw-medium mb-3">
                        @(Model.Job?.Company?.CompanyName ?? "Company Not Specified")
                    </p>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <span class="text-muted small d-block">Location</span>
                            <span class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(Model.Job?.Location) ? "Remote / Unspecified" : Model.Job.Location)</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Employment Type</span>
                            <span class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(Model.Job?.EmploymentType) ? "Full-Time" : Model.Job.EmploymentType)</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Offered Salary</span>
                            <span class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(Model.Job?.Salary) ? "Negotiable" : Model.Job.Salary)</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Posted On</span>
                            <span class="fw-medium text-dark">@Model.Job?.PostedDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Job?.Description))
                    {
                        <hr />
                        <h6 class="fw-bold text-dark">Description</h6>
                        <p class="text-muted small mb-3">@Model.Job.Description</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Job?.Requirements))
                    {
                        <hr />
                        <h6 class="fw-bold text-dark">Requirements</h6>
                        <p class="text-muted small mb-0">@Model.Job.Requirements</p>
                    }
                </div>
            </div>
        </div>

        <!-- Applicant & Resume Card -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold">Applicant Resume & Info</h5>
                </div>
                <div class="card-body">
                    @if (Model.JobSeeker != null)
                    {
                        <h3 class="h4 text-dark mb-1">@Model.JobSeeker.FirstName @Model.JobSeeker.LastName</h3>
                        <div class="row g-2 text-muted small mb-3">
                            <div class="col-12">
                                <strong>Email:</strong> @(Model.JobSeeker.User?.Email ?? "N/A")
                            </div>
                            <div class="col-12">
                                <strong>Phone:</strong> @(string.IsNullOrWhiteSpace(Model.JobSeeker.Phone) ? "Not provided" : Model.JobSeeker.Phone)
                            </div>
                            <div class="col-12">
                                <strong>Address:</strong> @(string.IsNullOrWhiteSpace(Model.JobSeeker.Address) ? "Not provided" : Model.JobSeeker.Address)
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0">Resume Profile</h6>
                            @if (isJobSeeker && Model.JobSeeker.Resume != null)
                            {
                                <a asp-controller="Resume" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                    View / Edit Resume
                                </a>
                            }
                        </div>

                        @if (Model.JobSeeker.Resume != null)
                        {
                            <div class="mb-3">
                                <span class="text-muted small d-block fw-semibold">Professional Summary</span>
                                <p class="text-dark small mb-0">@(string.IsNullOrWhiteSpace(Model.JobSeeker.Resume.Summary) ? "No summary provided." : Model.JobSeeker.Resume.Summary)</p>
                            </div>

                            <div class="mb-3">
                                <span class="text-muted small d-block fw-semibold">Education</span>
                                <p class="text-dark small mb-0">@(string.IsNullOrWhiteSpace(Model.JobSeeker.Resume.Education) ? "No education specified." : Model.JobSeeker.Resume.Education)</p>
                            </div>

                            <div class="mb-3">
                                <span class="text-muted small d-block fw-semibold">Work Experience</span>
                                <p class="text-dark small mb-0">@(string.IsNullOrWhiteSpace(Model.JobSeeker.Resume.Experience) ? "No experience specified." : Model.JobSeeker.Resume.Experience)</p>
                            </div>

                            @if (Model.JobSeeker.Resume.ResumeSkills != null && Model.JobSeeker.Resume.ResumeSkills.Any())
                            {
                                <div>
                                    <span class="text-muted small d-block fw-semibold mb-1">Skills</span>
                                    <div>
                                        @foreach (var rs in Model.JobSeeker.Resume.ResumeSkills)
                                        {
                                            <span class="badge badge-neutral me-1 mb-1">@rs.Skill?.Name</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info text-muted small mb-0">
                                Candidate has not created a resume profile.
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Applicant profile details are unavailable.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Company Feedback Section -->
    <div class="card mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold">Company Feedback</h5>
        </div>
        <div class="card-body">
            @if (Model.Feedback != null && !string.IsNullOrWhiteSpace(Model.Feedback.FeedbackText))
            {
                <div class="p-3 bg-subtle rounded border">
                    <p class="text-dark mb-2" style="white-space: pre-line;">@Model.Feedback.FeedbackText</p>
                    <span class="text-muted small d-block">
                        Provided on @Model.Feedback.FeedbackDate.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")
                    </span>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No feedback has been provided yet.
                </div>
            }
        </div>
    </div>

    <!-- Company Decision & Feedback Control Panel -->
    @if (isCompany)
    {
        <div class="card mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold">Application Decision & Feedback</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Enter feedback or instructions for the candidate (e.g., interview schedule, acceptance message, or rejection reason). 
                    <strong class="text-danger">Feedback is required when rejecting an application.</strong>
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <form asp-action="Accept" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ApplicationId" />

                            <div class="mb-3">
                                <label for="acceptFeedback" class="form-label">Acceptance Message / Interview Details (Optional)</label>
                                <textarea id="acceptFeedback" name="feedbackText" class="form-control" rows="3" placeholder="e.g. Congratulations! We would like to invite you for an interview on Monday at 10:00 AM.">@(Model.Feedback?.FeedbackText)</textarea>
                            </div>

                            <button type="submit" class="btn btn-success w-100">
                                Accept Application
                            </button>
                        </form>
                    </div>

                    <div class="col-md-6">
                        <form asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ApplicationId" />

                            <div class="mb-3">
                                <label for="rejectFeedback" class="form-label">Rejection Reason / Feedback (Required)</label>
                                <textarea id="rejectFeedback" name="feedbackText" class="form-control" rows="3" placeholder="e.g. Thank you for applying. Unfortunately, we have decided to move forward with another candidate whose qualifications more closely match our current needs.">@(Model.Feedback?.FeedbackText)</textarea>
                            </div>

                            <button type="submit" class="btn btn-danger w-100">
                                Reject Application
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
