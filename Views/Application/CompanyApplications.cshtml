@model IEnumerable<WorkAt.Models.Application>

@{
    ViewData["Title"] = "Candidate Applications";
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">Candidate Applications</h1>
            <p class="text-muted mb-0">Review candidates and manage hiring decisions for your open roles.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card p-5 text-center">
            <h3 class="h5 text-dark mb-2">No applications received yet</h3>
            <p class="text-muted small mb-0">When candidates apply for your posted jobs, their profiles will appear here.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Candidate</th>
                            <th>Applied For</th>
                            <th>Contact</th>
                            <th>Applied Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        @app.JobSeeker?.FirstName @app.JobSeeker?.LastName
                                    </div>
                                    @if (app.JobSeeker?.Resume != null)
                                    {
                                        <span class="text-muted small">Resume Attached</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-medium">@(app.Job?.Title ?? "Unknown Role")</span>
                                </td>
                                <td>
                                    <div class="small text-dark">@(app.JobSeeker?.User?.Email ?? "N/A")</div>
                                    <div class="small text-muted">@(string.IsNullOrWhiteSpace(app.JobSeeker?.Phone) ? "No phone" : app.JobSeeker?.Phone)</div>
                                </td>
                                <td class="text-muted small">
                                    @app.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    @if (app.Status == "Accepted")
                                    {
                                        <span class="badge badge-accepted">Accepted</span>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span class="badge badge-rejected">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                            Profile
                                        </a>

                                        @if (app.Status == "Pending")
                                        {
                                            <form asp-action="Accept" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@app.ApplicationId" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Accept Application">
                                                    Accept
                                                </button>
                                            </form>

                                            <form asp-action="Reject" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@app.ApplicationId" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Reject Application">
                                                    Reject
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>