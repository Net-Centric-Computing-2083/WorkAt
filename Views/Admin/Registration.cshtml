@model WorkAt.Models.AdminRegisterViewModel

@{
    ViewData["Title"] = "Admin Registration";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Admin Registration</h2>
            <p>Create an authorized administrator account</p>
        </div>

        <form asp-action="Registration" asp-controller="Admin" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Administrator Email
                </label>
                <input asp-for="Email" type="email" class="form-control" placeholder="admin@workat.com" autofocus autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Password
                </label>
                <div class="position-relative">
                    <input asp-for="Password" type="password" id="regPasswordInput" class="form-control pe-5" placeholder="Enter password" autocomplete="new-password" />
                    <button type="button" 
                            id="regTogglePasswordBtn" 
                            class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-1 text-decoration-none"
                            onclick="toggleVisibility('regPasswordInput', 'regTogglePasswordBtn')"
                            tabindex="-1"
                            style="font-size: 0.75rem;">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm Password
                </label>
                <div class="position-relative">
                    <input asp-for="ConfirmPassword" type="password" id="regConfirmPasswordInput" class="form-control pe-5" placeholder="Confirm password" autocomplete="new-password" />
                    <button type="button" 
                            id="regToggleConfirmPasswordBtn" 
                            class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-1 text-decoration-none"
                            onclick="toggleVisibility('regConfirmPasswordInput', 'regToggleConfirmPasswordBtn')"
                            tabindex="-1"
                            style="font-size: 0.75rem;">
                        Show
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                Register Admin
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top d-flex justify-content-center gap-3">
            <a asp-controller="Admin" asp-action="Login" class="small text-muted text-decoration-none">
                Sign In
            </a>
            <span class="text-muted small">&bull;</span>
            <a asp-controller="Home" asp-action="Index" class="small text-muted text-decoration-none">
                Homepage
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleVisibility(inputId, btnId) {
            const passwordInput = document.getElementById(inputId);
            const toggleBtn = document.getElementById(btnId);
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleBtn.textContent = "Hide";
            } else {
                passwordInput.type = "password";
                toggleBtn.textContent = "Show";
            }
        }
    </script>
}
