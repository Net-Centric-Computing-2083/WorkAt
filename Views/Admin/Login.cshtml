@model WorkAt.Models.LoginViewModel

@{
    ViewData["Title"] = "Admin Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Admin Sign In</h2>
            <p>Sign in to access platform administration</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2 small mb-4" role="alert">
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Login" asp-controller="Admin" asp-route-returnUrl="@returnUrl" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Administrator Email
                </label>
                <input asp-for="Email" type="email" class="form-control" placeholder="admin@workat.com" autofocus autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Password
                </label>
                <div class="position-relative">
                    <input asp-for="Password" type="password" id="adminPasswordInput" class="form-control pe-5" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" 
                            id="adminTogglePasswordBtn" 
                            class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-1 text-decoration-none"
                            onclick="toggleAdminPasswordVisibility()"
                            tabindex="-1"
                            style="font-size: 0.75rem;">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" id="adminRememberMeCheck" />
                <label asp-for="RememberMe" class="form-check-label small text-secondary" for="adminRememberMeCheck">
                    Keep me signed in
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                Sign In
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <a asp-controller="Home" asp-action="Index" class="small text-muted text-decoration-none">
                &larr; Return to WorkAt Homepage
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleAdminPasswordVisibility() {
            const passwordInput = document.getElementById("adminPasswordInput");
            const toggleBtn = document.getElementById("adminTogglePasswordBtn");
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleBtn.textContent = "Hide";
            } else {
                passwordInput.type = "password";
                toggleBtn.textContent = "Show";
            }
        }
    </script>
}
