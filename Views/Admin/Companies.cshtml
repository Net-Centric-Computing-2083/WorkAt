@model WorkAt.Models.AdminCompaniesViewModel

@{
    ViewData["Title"] = "Manage Companies";
    var startItem = Model.TotalItems == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var endItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems);
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">Manage Companies</h1>
            <p class="text-muted mb-0">Review company verification requests and manage registered employer profiles.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Controls -->
    <div class="admin-filter-card mb-4">
        <form asp-action="Companies" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label for="search" class="form-label">Search Companies</label>
                    <input type="text"
                           id="search"
                           name="search"
                           class="form-control"
                           placeholder="Search by company name, email, phone, location..."
                           value="@Model.Search" />
                </div>

                <div class="col-md-4">
                    <label for="status" class="form-label">Verification Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                        <option value="Verified" selected="@(Model.Status == "Verified")">Verified</option>
                        <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
                    {
                        <a asp-action="Companies" class="btn btn-secondary" title="Clear Filters">
                            Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Companies.Any())
    {
        <div class="admin-panel p-5 text-center">
            <h3 class="h5 text-dark mb-2">No companies found</h3>
            <p class="text-muted small mb-0">No company records match your current search or status filter.</p>
        </div>
    }
    else
    {
        <div class="admin-panel">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 50px;">No.</th>
                            <th>Company Name</th>
                            <th>Email</th>
                            <th>Contact / Location</th>
                            <th>Registration Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var compList = Model.Companies.ToList();
                            for (int i = 0; i < compList.Count; i++)
                            {
                                var c = compList[i];
                                int displayNo = (Model.PageIndex - 1) * Model.PageSize + i + 1;
                                <tr>
                                    <td class="text-center text-muted small fw-medium">@displayNo</td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            <a asp-action="CompanyDetails" asp-route-id="@c.CompanyId" class="text-dark text-decoration-none">
                                                @c.CompanyName
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(c.Website))
                                        {
                                            <div class="text-muted small">
                                                <a href="@c.Website" target="_blank" rel="noopener noreferrer" class="text-secondary small">
                                                    @c.Website
                                                </a>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark">@(c.User?.Email ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <div class="text-dark small">@(string.IsNullOrWhiteSpace(c.Phone) ? "—" : c.Phone)</div>
                                        <div class="text-muted small">@(string.IsNullOrWhiteSpace(c.Address) ? "—" : c.Address)</div>
                                    </td>
                                    <td class="text-muted small">
                                        @c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (c.Status == "Verified")
                                        {
                                            <span class="badge badge-accepted">Verified</span>
                                        }
                                        else if (c.Status == "Rejected")
                                        {
                                            <span class="badge badge-rejected">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <a asp-action="CompanyDetails" asp-route-id="@c.CompanyId" class="btn btn-sm btn-outline-secondary" title="View Profile">
                                                Details
                                            </a>

                                            @if (c.Status != "Verified")
                                            {
                                                <form asp-action="VerifyCompany" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve and Verify Company">
                                                        Verify
                                                    </button>
                                                </form>
                                            }

                                            @if (c.Status != "Rejected")
                                            {
                                                <form asp-action="RejectCompany" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Reject Company">
                                                        Reject
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="admin-panel-footer d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    Showing @startItem to @endItem of @Model.TotalItems compan@(Model.TotalItems == 1 ? "y" : "ies")
                </span>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Company Pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Companies"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-page="@(Model.PageIndex - 1)">&laquo; Prev</a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Companies"
                                       asp-route-search="@Model.Search"
                                       asp-route-status="@Model.Status"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Companies"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-page="@(Model.PageIndex + 1)">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>
