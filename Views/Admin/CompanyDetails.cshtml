@model WorkAt.Models.Company

@{
    ViewData["Title"] = $"{Model.CompanyName} - Company Details";
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h2 mb-0">@Model.CompanyName</h1>
                @if (Model.Status == "Verified")
                {
                    <span class="badge badge-accepted">Verified</span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge badge-rejected">Rejected</span>
                }
                else
                {
                    <span class="badge badge-pending">Pending</span>
                }
            </div>
            <p class="text-muted mb-0">Registered @Model.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Companies" class="btn btn-outline-secondary">
                &larr; Back to Companies
            </a>

            @if (Model.Status != "Verified")
            {
                <form asp-action="VerifyCompany" asp-route-id="@Model.CompanyId" asp-route-returnUrl="@Url.Action("CompanyDetails", new { id = Model.CompanyId })" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        Verify Company
                    </button>
                </form>
            }

            @if (Model.Status != "Rejected")
            {
                <form asp-action="RejectCompany" asp-route-id="@Model.CompanyId" asp-route-returnUrl="@Url.Action("CompanyDetails", new { id = Model.CompanyId })" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        Reject Company
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- Company Information -->
        <div class="col-lg-5">
            <div class="admin-panel h-100">
                <div class="admin-panel-header">
                    <span>Organization Profile</span>
                </div>
                <div class="admin-panel-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <span class="text-muted small d-block">Account Email</span>
                            <span class="fw-semibold text-dark">@(Model.User?.Email ?? "N/A")</span>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Contact Phone</span>
                            <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</span>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Website</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Website))
                            {
                                <a href="@Model.Website" target="_blank" rel="noopener noreferrer" class="text-dark text-decoration-underline small">
                                    @Model.Website
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">Not provided</span>
                            }
                        </div>

                        <div class="col-12">
                            <span class="text-muted small d-block">Office Address</span>
                            <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</span>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                            <span class="text-muted small d-block mb-1">Company Description</span>
                            <p class="text-secondary small mb-0" style="white-space: pre-line;">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Posted Jobs -->
        <div class="col-lg-7">
            <div class="admin-panel h-100">
                <div class="admin-panel-header">
                    <span>Posted Job Listings (@(Model.Jobs?.Count ?? 0))</span>
                </div>
                <div>
                    @if (Model.Jobs != null && Model.Jobs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Job Title</th>
                                        <th>Type / Location</th>
                                        <th>Posted</th>
                                        <th>Applicants</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in Model.Jobs.OrderByDescending(j => j.PostedDate))
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">@job.Title</div>
                                                <div class="text-muted small">@(string.IsNullOrWhiteSpace(job.Salary) ? "Salary not listed" : job.Salary)</div>
                                            </td>
                                            <td>
                                                <div class="small text-dark">@(job.EmploymentType ?? "Full Time")</div>
                                                <div class="text-muted small">@(job.Location ?? "Unspecified")</div>
                                            </td>
                                            <td class="text-muted small">
                                                @job.PostedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                            </td>
                                            <td>
                                                <span class="badge badge-neutral">
                                                    @(job.Applications?.Count ?? 0) applicant@(job.Applications?.Count == 1 ? "" : "s")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted small">
                            This company has not posted any jobs yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
