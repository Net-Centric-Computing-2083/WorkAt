@model WorkAt.Models.AdminApplicationsViewModel

@{
    ViewData["Title"] = "All Applications";
    var startItem = Model.TotalItems == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var endItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems);
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h2 mb-1">Application Log</h1>
            <p class="text-muted mb-0">System-wide log of job applications, applicant contact info, and attached PDF resumes.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="admin-filter-card mb-4">
        <form asp-action="Applications" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label for="search" class="form-label">Search Applications</label>
                    <input type="text"
                           id="search"
                           name="search"
                           class="form-control"
                           placeholder="Search by candidate name, job title, company..."
                           value="@Model.Search" />
                </div>

                <div class="col-md-4">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                        <option value="Accepted" selected="@(Model.Status == "Accepted")">Accepted</option>
                        <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Filter
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
                    {
                        <a asp-action="Applications" class="btn btn-secondary" title="Clear Filters">
                            Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Applications.Any())
    {
        <div class="admin-panel p-5 text-center">
            <h3 class="h5 text-dark mb-2">No applications found</h3>
            <p class="text-muted small mb-0">No application records match your current search or status filter.</p>
        </div>
    }
    else
    {
        <div class="admin-panel">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 50px;">No.</th>
                            <th>Candidate</th>
                            <th>Applied Role</th>
                            <th>Company</th>
                            <th>Applied Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var appList = Model.Applications.ToList();
                            for (int i = 0; i < appList.Count; i++)
                            {
                                var app = appList[i];
                                int displayNo = (Model.PageIndex - 1) * Model.PageSize + i + 1;
                                <tr>
                                    <td class="text-center text-muted small fw-medium">@displayNo</td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @app.JobSeeker?.FirstName @app.JobSeeker?.LastName
                                        </div>
                                        <div class="text-muted small">@(app.JobSeeker?.User?.Email ?? "N/A")</div>
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@(app.Job?.Title ?? "Unknown Role")</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@(app.Job?.Company?.CompanyName ?? "Unknown Company")</span>
                                    </td>
                                    <td class="text-muted small">
                                        @app.AppliedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (app.Status == "Accepted")
                                        {
                                            <span class="badge badge-accepted">Accepted</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge badge-rejected">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="ApplicationDetails" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="admin-panel-footer d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    Showing @startItem to @endItem of @Model.TotalItems application@(Model.TotalItems == 1 ? "" : "s")
                </span>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Applications Pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Applications"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-page="@(Model.PageIndex - 1)">&laquo; Prev</a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Applications"
                                       asp-route-search="@Model.Search"
                                       asp-route-status="@Model.Status"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Applications"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-page="@(Model.PageIndex + 1)">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>
