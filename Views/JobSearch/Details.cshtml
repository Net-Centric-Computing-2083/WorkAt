@model WorkAt.Models.Job

@{
    ViewData["Title"] = Model.Title;
}

<div class="py-2" style="max-width: 800px; margin: 0 auto;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-controller="Jobs" asp-action="Index" class="text-secondary small fw-medium">
            &larr; Back to all jobs
        </a>
    </div>

    <div class="card p-4 p-md-5 mb-4">
        <!-- Header -->
        <div class="mb-4 pb-3 border-bottom">
            <h1 class="h2 mb-2">@Model.Title</h1>
            <div class="h5 fw-normal text-secondary mb-3">
                @(Model.Company?.CompanyName ?? "Confidential Employer")
            </div>

            <div class="d-flex flex-wrap gap-2">
                @if (!string.IsNullOrWhiteSpace(Model.Location))
                {
                    <span class="job-meta-tag">@Model.Location</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.EmploymentType))
                {
                    <span class="job-meta-tag">@Model.EmploymentType</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Salary))
                {
                    <span class="job-meta-tag">@Model.Salary</span>
                }
                <span class="job-meta-tag">Posted @Model.PostedDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                @if (Model.Deadline.HasValue)
                {
                    if (Model.IsDeadlinePassed)
                    {
                        <span class="job-meta-tag badge-rejected">Deadline Passed: @Model.Deadline.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    }
                    else
                    {
                        <span class="job-meta-tag text-muted">Deadline: @Model.Deadline.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    }
                }
            </div>
        </div>

        <!-- Description -->
        <div class="mb-4">
            <h2 class="h5 mb-3">About the Role</h2>
            <div class="text-secondary" style="white-space: pre-line; line-height: 1.7;">
                @Model.Description
            </div>
        </div>

        <!-- Requirements -->
        @if (!string.IsNullOrWhiteSpace(Model.Requirements))
        {
            <div class="mb-4">
                <h2 class="h5 mb-3">Requirements &amp; Qualifications</h2>
                <div class="text-secondary" style="white-space: pre-line; line-height: 1.7;">
                    @Model.Requirements
                </div>
            </div>
        }

        <!-- About Company -->
        @if (Model.Company != null && !string.IsNullOrWhiteSpace(Model.Company.Description))
        {
            <div class="mb-4 pt-3 border-top">
                <h2 class="h5 mb-2">About @Model.Company.CompanyName</h2>
                <div class="text-secondary small" style="white-space: pre-line;">
                    @Model.Company.Description
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Company.Website))
                {
                    <div class="mt-2">
                        <a href="@Model.Company.Website" target="_blank" rel="noopener noreferrer" class="small text-decoration-underline text-dark">
                            Visit website &rarr;
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Apply CTA Section -->
        <div class="pt-4 border-top">
            @if (User.IsInRole("JobSeeker"))
            {
                if (ViewBag.HasApplied == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(ViewBag.ApplicationStatus == "Accepted" ? "badge-accepted" : ViewBag.ApplicationStatus == "Rejected" ? "badge-rejected" : "badge-pending") py-2 px-3">
                            Status: @ViewBag.ApplicationStatus
                        </span>
                        <span class="text-muted small">You have already submitted an application for this position.</span>
                    </div>
                }
                else if (Model.IsDeadlinePassed)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <h3 class="h6 fw-bold mb-1">Applications Closed</h3>
                        <p class="mb-0 small text-dark">The deadline for this position has passed (@(Model.Deadline?.ToLocalTime().ToString("MMM dd, yyyy"))). New applications are no longer being accepted.</p>
                    </div>
                }
                else if (ViewBag.JobSeekerStatus == "Verified")
                {
                    <div class="card p-3 bg-subtle border">
                        <h3 class="h6 fw-bold mb-2">Apply for this Position</h3>
                        <p class="text-secondary small mb-3">Your registered contact information and in-app profile will be submitted with this application. You can optionally attach an updated PDF resume.</p>
                        
                        <div id="fileClientError" class="alert alert-danger d-none mb-3" role="alert"></div>

                        <form id="applyJobForm" asp-controller="Application" asp-action="Apply" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="jobId" value="@Model.JobId" />

                            <div class="mb-3">
                                <label for="resumeFile" class="form-label fw-semibold">
                                    Attach PDF Resume <span class="badge badge-neutral ms-1">PDF Only &bull; Max 5MB</span>
                                </label>
                                <input type="file"
                                       id="resumeFile"
                                       name="resumeFile"
                                       class="form-control"
                                       accept=".pdf,application/pdf" />
                                <div class="form-text small text-muted">
                                    <strong>Accepted format:</strong> Standard PDF (.pdf) up to 5 MB. Other file formats (such as Word documents, images, and videos) are not accepted.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg" id="submitAppBtn">
                                Submit Application
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-3">
                        <strong>Account Awaiting Verification:</strong> Your account is awaiting Admin verification. You can apply for jobs after your account has been verified.
                    </div>
                    <button type="button" class="btn btn-primary btn-lg opacity-50" disabled>
                        Apply for this Position (Awaiting Verification)
                    </button>
                }
            }
            else if (!User.Identity?.IsAuthenticated ?? true)
            {
                if (Model.IsDeadlinePassed)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <h3 class="h6 fw-bold mb-1">Applications Closed</h3>
                        <p class="mb-0 small text-dark">The deadline for this position has passed. Applications are no longer accepted.</p>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "JobSearch", new { id = Model.JobId })"
                       class="btn btn-primary btn-lg">
                        Sign in to Apply
                    </a>
                    <span class="text-muted small ms-2">or <a asp-controller="Account" asp-action="Register" asp-route-role="JobSeeker" class="text-dark fw-semibold">create an account</a></span>
                }
            }
            else if (User.IsInRole("Company"))
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-neutral py-2 px-3">
                        Viewing listing in company mode
                    </span>
                    @if (Model.IsDeadlinePassed)
                    {
                        <span class="badge badge-rejected py-2 px-3">
                            Deadline Expired
                        </span>
                    }
                </div>
            }
            else if (User.IsInRole("Admin"))
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-neutral py-2 px-3">
                        Viewing listing in admin mode
                    </span>
                    @if (Model.IsDeadlinePassed)
                    {
                        <span class="badge badge-rejected py-2 px-3">
                            Deadline Expired
                        </span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('applyJobForm');
            const fileInput = document.getElementById('resumeFile');
            const errorDiv = document.getElementById('fileClientError');

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    validateFile();
                });
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!validateFile()) {
                        e.preventDefault();
                    }
                });
            }

            function validateFile() {
                if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                    hideError();
                    return true;
                }

                const file = fileInput.files[0];
                const fileName = file.name.toLowerCase();
                const isPdfExtension = fileName.endsWith('.pdf');
                const isPdfMime = file.type === 'application/pdf' || file.type === 'application/x-pdf' || file.type === '';

                if (!isPdfExtension || !isPdfMime) {
                    showError('Only PDF files (.pdf) are accepted. Formats like Word documents, images, and videos are not allowed.');
                    fileInput.value = '';
                    return false;
                }

                const maxSize = 5 * 1024 * 1024; // 5MB
                if (file.size > maxSize) {
                    showError('The selected PDF file exceeds the maximum allowed size of 5 MB.');
                    fileInput.value = '';
                    return false;
                }

                hideError();
                return true;
            }

            function showError(msg) {
                if (errorDiv) {
                    errorDiv.textContent = msg;
                    errorDiv.classList.remove('d-none');
                }
            }

            function hideError() {
                if (errorDiv) {
                    errorDiv.textContent = '';
                    errorDiv.classList.add('d-none');
                }
            }
        });
    </script>
}