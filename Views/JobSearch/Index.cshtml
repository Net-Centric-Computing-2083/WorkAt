@model WorkAt.Models.BrowseJobsViewModel

@{
    ViewData["Title"] = "Search Jobs";
    var startItem = Model.TotalItems == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var endItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems);
}

<div class="py-2">
    <!-- Header -->
    <div class="mb-4 pb-2 border-bottom">
        <h1 class="h2 mb-1">Search Opportunities</h1>
        <p class="text-muted mb-0">Browse open positions from verified companies on WorkAt.</p>
    </div>

    <!-- Search Bar -->
    <div class="card p-3 mb-4">
        <form asp-controller="JobSearch" asp-action="Index" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="keyword" class="form-label">Keyword or Title</label>
                    <input type="text"
                           id="keyword"
                           name="keyword"
                           class="form-control"
                           placeholder="e.g. AI Engineer, Python"
                           value="@Model.Keyword" />
                </div>

                <div class="col-md-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text"
                           id="location"
                           name="location"
                           class="form-control"
                           placeholder="e.g. Remote, Kathmandu"
                           value="@Model.Location" />
                </div>

                <div class="col-md-2">
                    <label for="employmentType" class="form-label">Employment Type</label>
                    <select id="employmentType" name="employmentType" class="form-select">
                        <option value="">All Types</option>
                        <option value="Full Time" selected="@(Model.EmploymentType == "Full Time")">Full Time</option>
                        <option value="Part Time" selected="@(Model.EmploymentType == "Part Time")">Part Time</option>
                        <option value="Contract" selected="@(Model.EmploymentType == "Contract")">Contract</option>
                        <option value="Internship" selected="@(Model.EmploymentType == "Internship")">Internship</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="salary" class="form-label">Salary Range</label>
                    <select id="salary" name="salary" class="form-select">
                        <option value="">Any Salary</option>
                        <option value="under-30k" selected="@(Model.Salary == "under-30k")">Under 30,000</option>
                        <option value="30k-50k" selected="@(Model.Salary == "30k-50k")">30,000 - 50,000</option>
                        <option value="50k-100k" selected="@(Model.Salary == "50k-100k" || Model.Salary == "50k+")">50,000 - 100,000</option>
                        <option value="100k+" selected="@(Model.Salary == "100k+")">100,000+</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Search
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Keyword) || !string.IsNullOrEmpty(Model.Location) || !string.IsNullOrEmpty(Model.EmploymentType) || !string.IsNullOrEmpty(Model.Salary))
                    {
                        <a asp-action="Index" class="btn btn-secondary" title="Clear Filters">
                            Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Jobs Grid -->
    @if (Model.Jobs != null && Model.Jobs.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">Showing @startItem to @endItem of @Model.TotalItems open role@(Model.TotalItems == 1 ? "" : "s")</span>
        </div>

        <div class="row g-3 mb-4">
            @foreach (var job in Model.Jobs)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="job-card">
                        <div class="job-card-title">@job.Title</div>
                        <div class="job-card-company">@(job.Company?.CompanyName ?? "Confidential")</div>

                        <div class="job-card-meta">
                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <span class="job-meta-tag">@job.Location</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                            {
                                <span class="job-meta-tag">@job.EmploymentType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(job.Salary))
                            {
                                <span class="job-meta-tag">@job.Salary</span>
                            }
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                @job.PostedDate.ToLocalTime().ToString("MMM dd")
                            </span>
                            <a asp-action="Details"
                               asp-route-id="@job.JobId"
                               class="btn btn-sm btn-outline-primary">
                                View Details &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="Search Jobs Pagination">
                    <ul class="pagination">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-location="@Model.Location"
                               asp-route-employmentType="@Model.EmploymentType"
                               asp-route-salary="@Model.Salary"
                               asp-route-page="@(Model.PageIndex - 1)">&laquo; Prev</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-location="@Model.Location"
                                   asp-route-employmentType="@Model.EmploymentType"
                                   asp-route-salary="@Model.Salary"
                                   asp-route-page="@p">@p</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-location="@Model.Location"
                               asp-route-employmentType="@Model.EmploymentType"
                               asp-route-salary="@Model.Salary"
                               asp-route-page="@(Model.PageIndex + 1)">Next &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="card p-5 text-center">
            <h3 class="h5 text-dark mb-2">No matching jobs found</h3>
            <p class="text-muted small mb-3">Try adjusting your keywords, location, or employment type filters.</p>
            <div>
                <a asp-action="Index" class="btn btn-sm btn-secondary">Reset Filters</a>
            </div>
        </div>
    }
</div>