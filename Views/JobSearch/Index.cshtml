@model IEnumerable<WorkAt.Models.Job>

@{
    ViewData["Title"] = "Find Jobs";
}

<div class="container py-5">
    <div class="mb-4">
        <h1>Find Jobs</h1>
        <p>Search for jobs that match your skills and interests.</p>
    </div>

    <form asp-controller="JobSearch" asp-action="Index" method="get" class="mb-5">
        <div class="row g-3">
            <div class="col-md-5">
                <label for="keyword" class="form-label">Keyword</label>
                <input type="text"
                       id="keyword"
                       name="keyword"
                       class="form-control"
                       placeholder="Job title or keyword"
                       value="@ViewBag.Keyword" />
            </div>

            <div class="col-md-3">
                <label for="location" class="form-label">Location</label>
                <input type="text"
                       id="location"
                       name="location"
                       class="form-control"
                       placeholder="e.g. Kathmandu"
                       value="@ViewBag.Location" />
            </div>

            <div class="col-md-3">
                <label for="employmentType" class="form-label">Employment Type</label>
                <select id="employmentType"
                        name="employmentType"
                        class="form-select">

                    <option value="">All Types</option>

                    <option value="Full Time"
                            selected="@(ViewBag.EmploymentType == "Full Time")">
                        Full Time
                    </option>

                    <option value="Part Time"
                            selected="@(ViewBag.EmploymentType == "Part Time")">
                        Part Time
                    </option>

                    <option value="Internship"
                            selected="@(ViewBag.EmploymentType == "Internship")">
                        Internship
                    </option>

                    <option value="Contract"
                            selected="@(ViewBag.EmploymentType == "Contract")">
                        Contract
                    </option>
                </select>
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    Search
                </button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="mb-3">
            <h2>Available Jobs</h2>
        </div>

        <div class="row g-4">
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title">@job.Title</h3>

                            @if (job.Company != null)
                            {
                                <p class="text-muted mb-2">
                                    @job.Company.CompanyName
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <p class="mb-2">
                                    <strong>Location:</strong>
                                    @job.Location
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                            {
                                <p class="mb-2">
                                    <strong>Type:</strong>
                                    @job.EmploymentType
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(job.Salary))
                            {
                                <p class="mb-2">
                                    <strong>Salary:</strong>
                                    @job.Salary
                                </p>
                            }

                            <p class="text-muted mt-auto">
                                Posted @job.PostedDate.ToLocalTime().ToString("MMM dd, yyyy")
                            </p>

                            <a asp-controller="JobSearch"
                               asp-action="Details"
                               asp-route-id="@job.JobId"
                               class="btn btn-outline-primary">
                                View Details
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h3>No jobs found</h3>
            <p class="text-muted">
                We couldn't find any jobs matching your search.
                Try changing your keyword or filters.
            </p>

            <a asp-controller="JobSearch"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Clear Filters
            </a>
        </div>
    }
</div>